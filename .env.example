# 根目录 Next.js 环境变量
# 生产环境请把真实值放在部署平台的服务端变量中，不要使用 NEXT_PUBLIC_ 前缀保存密钥。

# Go CMS API 地址：本地开发时 Next.js 会将 /api/v1/* 同源代理到该服务
CMS_API_PROXY_URL=http://127.0.0.1:8080

# Next 服务端公开读取 Go CMS 内容；生产环境应设为 Go API 的内部地址
CMS_CONTENT_API_URL=http://127.0.0.1:8080

# Go API 触发前台缓存刷新的共享密钥；必须与 backend/.env 中的值完全一致。
# 修改后需要同时重启 Next.js 与 Go CMS API。
CMS_NEXT_REVALIDATE_SECRET=

# SMTP 授权码，只放服务端环境变量，不写入运行时 JSON
SMTP_PASS=

# 站点主域名，收录脚本会优先读取
NEXT_PUBLIC_SITE_URL=https://example.com
# 仅服务端脚本使用的站点地址
SITE_URL=https://example.com

# 构建/手动收录脚本使用的服务端密钥；Go 后台推送还需在 backend/.env 配置同名变量。
# 仅在需要对应功能时填写，绝不能提交到 Git 或改成 NEXT_PUBLIC_*。
CMS_BAIDU_PUSH_TOKEN=
CMS_INDEXNOW_KEY=

# 不要设置为 0；否则会关闭 TLS 证书校验并带来安全风险
# NODE_TLS_REJECT_UNAUTHORIZED=
