# SQLite 数据库文件位置
DATABASE_URL=./storage/db/blog.sqlite

# Go CMS API 地址：本地开发时 Next.js 会将 /api/v1/* 同源代理到该服务
CMS_API_PROXY_URL=http://127.0.0.1:8080

# Next 服务端公开读取 Go CMS 内容；生产环境应设为 Go API 的内部地址
CMS_CONTENT_API_URL=http://127.0.0.1:8080

# Go API 触发前台缓存刷新的共享密钥；只设置在 Go/Next 服务器环境变量中
CMS_NEXT_REVALIDATE_SECRET=

# 管理后台会话密钥，生产环境请替换为高强度随机串
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# 管理员登录密码
ADMIN_PASSWORD=change-me-now
# 是否跳过后台登录校验，生产环境务必保持 false
ADMIN_BYPASS_LOGIN=false
# 是否启用后台入口
ENABLE_ADMIN=true

# SMTP 授权码，只放 .env，不再写入运行时 JSON
SMTP_PASS=

# 站点主域名，收录脚本会优先读取
NEXT_PUBLIC_SITE_URL=https://example.com
# 兼容脚本读取的站点地址
SITE_URL=https://example.com

# 百度主动推送 Token
BAIDU_PUSH_TOKEN=
# IndexNow Key
INDEXNOW_KEY=

# 不要设置为 0；否则会关闭 TLS 证书校验并带来安全风险
# NODE_TLS_REJECT_UNAUTHORIZED=
