# Go CMS API 服务端环境变量
# 真实值不要提交；修改密钥、路径或外部服务配置后必须重启 Go CMS API。
# 后台“SEO 推送”密钥写入位置；相对 Go API 工作目录，生产可设置为绝对路径
CMS_ENV_FILE=.env

# Go CMS API 监听地址
CMS_API_ADDR=:8080

# 相对于 backend/ 目录；生产环境推荐绝对路径
CMS_DATABASE_PATH=../storage/db/blog.sqlite

# 首次启动会被 bcrypt 哈希并写入 SQLite，之后请使用后台改密；不要使用示例值
CMS_ADMIN_PASSWORD=

# HTTPS 反向代理环境设为 true；本地开发可设为 false
CMS_COOKIE_SECURE=false

# 管理员会话有效期（天）
CMS_SESSION_DAYS=30

# 后续系统更新任务使用：仓库和分支只能在环境变量中固定配置
CMS_REPOSITORY_DIR=/srv/xuzhan
CMS_GIT_BRANCH=main
CMS_GIT_REMOTE=origin

# 回滚脚本同样必须由服务器固定配置；不得由后台传入命令或 Commit
CMS_ROLLBACK_SCRIPT=/srv/xuzhan/scripts/rollback.sh

# 发布缓存刷新：不可暴露给浏览器；CMS_NEXT_REVALIDATE_SECRET 必须与根目录 .env 相同
CMS_NEXT_REVALIDATE_URL=http://127.0.0.1:3000/api/internal/revalidate
CMS_NEXT_REVALIDATE_SECRET=

# SEO 推送密钥，仅服务器环境变量读取，后台页面只显示“已配置/未配置”
# 激活步骤：后台可直接写入；手动修改此文件后重启 Go CMS API → 后台“SEO 推送”页面刷新状态
CMS_INDEXNOW_KEY=
CMS_BAIDU_PUSH_TOKEN=
