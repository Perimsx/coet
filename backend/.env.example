# Go CMS API 监听地址
CMS_API_ADDR=:8080

# 相对于 backend/ 目录；生产环境推荐绝对路径
CMS_DATABASE_PATH=../storage/db/blog.sqlite

# 首次启动会被 bcrypt 哈希并写入 SQLite，之后请使用后台改密
CMS_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# HTTPS 反向代理环境设为 true；本地开发可设为 false
CMS_COOKIE_SECURE=false

# 管理员会话有效期（天）
CMS_SESSION_DAYS=30

# 后续系统更新任务使用：仓库和分支只能在环境变量中固定配置
CMS_REPOSITORY_DIR=/srv/cot-blog
CMS_GIT_BRANCH=main

# 后续发布缓存刷新使用：不可暴露给前端
CMS_NEXT_REVALIDATE_URL=http://127.0.0.1:3000/api/internal/revalidate
CMS_NEXT_REVALIDATE_SECRET=replace-with-a-random-secret
