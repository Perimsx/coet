{
  "name": "xuzhan",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "prepare:generated-content": "tsx ./scripts/build/prepare-generated-content.ts",
    "setup": "node scripts/setup.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev:all": "node scripts/run-all.mjs",
    "start:all": "node scripts/run-all.mjs --prod",
    "dev": "pnpm prepare:generated-content && contentlayer2 build && cross-env NEXT_DIST_DIR=.next-dev next dev -H 127.0.0.1",
    "dev:api": "go -C backend run ./cmd/server",
    "test:api": "go -C backend test ./...",
    "dev:clean": "node -e \"['.next-dev','.contentlayer','.next'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\" && pnpm prepare:generated-content && contentlayer2 build && cross-env NEXT_DIST_DIR=.next-dev next dev -H 127.0.0.1",
    "start": "next start",
    "build": "pnpm prepare:generated-content && contentlayer2 build && cross-env STATIC_EXPORT=true NODE_TLS_REJECT_UNAUTHORIZED=1 next build && cross-env NODE_TLS_REJECT_UNAUTHORIZED=1 tsx ./scripts/build/postbuild.ts && (pnpm seo:push || true)",
    "build:standalone": "pnpm prepare:generated-content && contentlayer2 build && cross-env NODE_TLS_REJECT_UNAUTHORIZED=1 next build && cross-env NODE_TLS_REJECT_UNAUTHORIZED=1 tsx ./scripts/build/postbuild.ts && (pnpm seo:push || true)",
    "seo:push": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=1 tsx scripts/seo-push.ts",
    "serve": "next start",
    "analyze": "pnpm prepare:generated-content && cross-env ANALYZE=true next build",
    "lint": "eslint src/app src/features src/shared scripts --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint --fix src/app src/features src/shared scripts --ext .js,.jsx,.ts,.tsx",
    "typecheck": "pnpm prepare:generated-content && contentlayer2 build && tsc --noEmit"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@heroui/react": "^3.2.3",
    "@heroui/styles": "^3.2.3",
    "@next/bundle-analyzer": "16.2.9",
    "@next/third-parties": "^16.2.9",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "contentlayer2": "0.5.8",
    "framer-motion": "^12.40.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "kbar": "0.1.0-beta.48",
    "lucide-react": "^1.21.0",
    "mdx-bundler": "^10.1.1",
    "next": "16.2.9",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "pliny": "0.4.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "reading-time": "1.5.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^4.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/hast": "^3.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/trusted-types": "^2.0.7",
    "cross-env": "^10.1.0",
    "dotenv": "^8.6.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rehype-preset-minify": "7.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "contentlayer2",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.28.0"
}
